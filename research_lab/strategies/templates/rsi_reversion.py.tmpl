"""{{strategy_label}} — RSI mean reversion (generated from the RSI template, M4.5 R16).

Long-only RSI reversal on the close. Enter long when the {{rsi_period}}-bar RSI turns up through the
oversold line ({{oversold}}); exit when it turns down through the overbought line ({{overbought}}). A
starting scaffold — edit the rule freely from here.
"""
from __future__ import annotations

from strategies.base import RunResult, SettingRow, Strategy, StrategyInput
from strategies.helpers import default_costs, long_only_signal_result


class {{class_name}}(Strategy):
    """Long-only RSI mean-reversion, period {{rsi_period}}."""

    asset_class_scope = ("crypto", "equities")

    def run(self, data: StrategyInput, settings: list[SettingRow]) -> RunResult:
        close = data.close  # the closing-price series the RSI is built from

        # Wilder-style RSI in pandas (SMA of gains/losses; the parameterized rule).
        delta = close.diff()                                          # bar-over-bar price change
        gain = delta.clip(lower=0).rolling({{rsi_period}}).mean()     # average gain over the period
        loss = (-delta.clip(upper=0)).rolling({{rsi_period}}).mean()  # average loss over the period
        rs = gain / loss                                             # relative strength
        rsi = 100 - (100 / (1 + rs))                                # the RSI oscillator, 0..100

        # Cross signals: enter as RSI turns up out of oversold, exit as it turns down out of overbought.
        entries = (rsi > {{oversold}}) & (rsi.shift(1) <= {{oversold}})       # cross UP through oversold
        exits = (rsi < {{overbought}}) & (rsi.shift(1) >= {{overbought}})     # cross DOWN through overbought

        # Costs from the lab settings via the neutral key dispatch routed by asset class (M4 D2).
        fees, slippage = default_costs(settings)

        # The shared long-only portfolio build (R16) — no vbt call in the template body.
        return long_only_signal_result(data, entries, exits, fees, slippage, indicators={"rsi": rsi})
